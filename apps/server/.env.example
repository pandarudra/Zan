# =============================================================================
# apps/server — Environment Variables
# Copy this file to .env for local development.
# Set all variables in the Render service dashboard for production.
# =============================================================================

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# TCP port the HTTP server binds to.
# Render injects this automatically — do NOT set it manually on Render.
# For local dev only.
PORT=3001

# ---------------------------------------------------------------------------
# CORS — REQUIRED. Server throws on startup if this is missing.
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to make cross-origin requests.
# Must include your Vercel deployment URL in production.
# No trailing slashes.
# Example: https://your-app.vercel.app,https://your-custom-domain.com
# Local:   http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# JWT signing secret. Must match what the web app's NextAuth produces.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# Shared secret for internal service-to-service requests (X-Internal-Secret header).
# Generate with: openssl rand -hex 32
INTERNAL_SECRET=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# On Supabase: use the DIRECT connection (port 5432) for the server runtime.
# (The pooler / port 6543 is for serverless contexts like Vercel.)
# Example: postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Upstash Redis TLS URL. Used by BullMQ job queue and heartbeat monitor.
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:password@hostname:6379

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------

# Solana JSON-RPC endpoint.
# Use a paid RPC (Helius, QuickNode) for production mainnet reliability.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Escrow program authority keypair as a JSON byte array (64 bytes).
# Generate with: solana-keygen new --outfile authority.json --no-passphrase
# Then paste the contents of authority.json here.
# NEVER commit this value to the repository.
SOLANA_AUTHORITY_KEYPAIR=[0,0,0,0,...replace with 64 bytes...]

# Deployed escrow program ID on the target Solana cluster.
ESCROW_PROGRAM_ID=G4AGRutZdKry9rMnJiZt2Noz42ifwghgZxiXCETfXHGg

# ---------------------------------------------------------------------------
# Azure Blob Storage (required for file upload / job I/O)
# ---------------------------------------------------------------------------

# Full Azure Storage connection string.
# Found in Azure Portal → Storage Account → Access keys.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Azure Blob container names. Defaults apply if not set.
AZURE_STORAGE_CONTAINER_INPUTS=gnet-inputs
AZURE_STORAGE_CONTAINER_OUTPUTS=gnet-outputs
