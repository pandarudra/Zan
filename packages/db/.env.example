# =============================================================================
# packages/db — Environment Variables
# Copy this file to .env for local Prisma CLI operations.
# For production deployments, set these variables on the platform (Vercel/Render).
# =============================================================================

# Direct PostgreSQL connection string (bypasses connection pooler).
# Required by Prisma CLI for migrations (prisma migrate deploy).
# On Supabase: use port 5432 (not the pooler port 6543).
# Example: postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: separate direct URL for migrations when DATABASE_URL is a pooler URL.
# prisma.config.ts prefers DIRECT_URL over DATABASE_URL for CLI operations.
# Set this when DATABASE_URL points to a pooler (port 6543 on Supabase).
DIRECT_URL=postgresql://user:password@host:5432/dbname
